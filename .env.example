# Copy to .env (gitignored). Values here are for the local synthetic MockBank only.

# Service account the automation signs on with (referenced as {{secrets.*}} in capabilities)
MOCKBANK_USER=teller1
MOCKBANK_PASSWORD=teller-pass
MOCKBANK_URL=http://127.0.0.1:8765

# LLM for discovery only (replay never calls it). Gemini free tier via OpenAI-compatible endpoint.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# Seconds between LLM calls. Free tier allows ~5 requests/min per model.
LLM_MIN_INTERVAL_S=13
